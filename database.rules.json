{
  "rules": {
    "lb": {
      "$game": {
        ".read": "$game.matches(/^[a-z0-9]{1,12}$/)",
        ".indexOn": ["s"],
        "$pid": {
          ".write": "$game.matches(/^[a-z0-9]{1,12}$/) && $pid.matches(/^p[a-z0-9]{4,12}$/)",
          ".validate": "newData.hasChildren(['n','s','t']) && newData.child('n').isString() && newData.child('n').val().length >= 2 && newData.child('n').val().length <= 16 && newData.child('s').isNumber() && newData.child('s').val() > 0 && newData.child('s').val() < 100000 && newData.child('t').val() == now && (!data.exists() || newData.child('s').val() > data.child('s').val())",
          "n": {".validate": true}, "s": {".validate": true}, "t": {".validate": true},
          "$other": {".validate": false}
        }
      }
    },
    "mp": {
      "$code": {
        ".read": "$code.matches(/^[A-Z0-9]{4}$/)",
        ".write": "$code.matches(/^[A-Z0-9]{4}$/)",
        "h": {
          "n": {".validate": "newData.isString() && newData.val().length <= 16"},
          "c": {".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"},
          "$other": {".validate": false}
        },
        "g": {
          "n": {".validate": "newData.isString() && newData.val().length <= 16"},
          "c": {".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000"},
          "$other": {".validate": false}
        },
        "st": {".validate": "newData.isString() && newData.val().length <= 6"},
        "r": {".validate": "newData.isNumber()"},
        "w": {".validate": "newData.isString() && newData.val().length <= 2"},
        "t": {".validate": "newData.isNumber()"},
        "$other": {".validate": false}
      }
    },
    "$any": {".read": false, ".write": false}
  }
}
